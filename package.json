{
  "name": "kaprek",
  "version": "0.6.0",
  "description": "Local agent workspace around the Claude Code and Codex CLIs you already have: session viewer with search, chat turns, guided planning, a council of your other engines, scheduled triggers, and a deferred approval inbox. No API key, no account, no network of its own.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "agent",
    "approvals",
    "claude-code",
    "council",
    "local-first",
    "multi-agent",
    "planning",
    "session-viewer",
    "transcripts",
    "triggers"
  ],
  "author": "Klaus Arent",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "kaprek": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "src",
    "apps",
    "web/dist",
    "LICENSE",
    "README.md",
    "!src/**/*.test.mjs",
    "!src/**/fixtures/**"
  ],
  "scripts": {
    "test": "vitest run && npm run test:web",
    "test:server": "vitest run",
    "test:web": "cd web && vitest run",
    "build:web": "cd web && npm run build",
    "package:win": "node scripts/package-win.mjs",
    "prepublishOnly": "npm run build:web && npm test"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klausarent/kaprek.git"
  },
  "homepage": "https://github.com/klausarent/kaprek#readme",
  "bugs": {
    "url": "https://github.com/klausarent/kaprek/issues"
  }
}
